    local keyBox = new("TextBox", {
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.fromOffset(8, 0),
        BackgroundTransparency = 1,
        Text = "",
        PlaceholderText = "Masukkan key...",
        PlaceholderColor3 = C.Dim,
        TextColor3 = C.Text,
        TextSize = 12,
        Font = Enum.Font.Code,
        ClearTextOnFocus = false,
    }, inputFrame)

    local msg = new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 14),
        Position = UDim2.fromOffset(12, 76),
        BackgroundTransparency = 1,
        Text = "Masukkan key untuk membuka tools.",
        TextColor3 = C.SubText,
        TextSize = 9,
        Font = Enum.Font.Code,
    }, box)

    local verify = new("TextButton", {
        Size = UDim2.new(1, -24, 0, 32),
        Position = UDim2.fromOffset(12, 100),
        BackgroundColor3 = C.Accent,
        Text = "VERIFY",
        TextColor3 = C.White,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        BorderSizePixel = 0,
    }, box)
    corner(verify, 6)

    local function check()
        if trim(keyBox.Text) == CONFIG.KEY then
            msg.Text = "Key benar!"
            msg.TextColor3 = C.Green
            task.wait(0.4)
            keyGui:Destroy()
            startToolbox()
        else
            msg.Text = "Key salah, coba lagi."
            msg.TextColor3 = C.Red
        end
    end

    verify.MouseButton1Click:Connect(check)

    keyBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            check()
        end
    end)
end

showKeyScreen()
