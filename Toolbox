--========================== DISPLAY =========================
local function displayResults(items)
    clearResults()

    local order = 0

    for _, item in ipairs(items or {}) do
        local id = getAssetId(item)

        if id then
            local lower = getAssetName(item):lower()

            if not (
                lower:find("content deleted", 1, true)
                or lower:find("[deleted]", 1, true)
                or lower:find("(deleted)", 1, true)
            ) then
                order += 1
                createCard(item, CurrentCategory, order)
            end
        end
    end

    if order == 0 then
        addLog("Tidak ada hasil.", C.Yellow)
    end
end

--========================== SEARCH ==========================
local function search(query, page)
    query = trim(query)

    if Searching then return end

    if CurrentCategory ~= "Favorites" and query == "" then
        clearResults()
        addLog("Masukkan keyword terlebih dahulu.", C.Yellow)
        return
    end

    Searching = true
    SearchToken += 1
    local token = SearchToken

    SearchButton.Text = "..."
    SearchButton.Active = false

    if page == 0 then
        CurrentPage = 0
        AudioPages = nil
        clearResults()
        addLog("QUERY: " .. query, C.Cyan)
        addLog("Fetching from Roblox Creator Store...", C.SubText)
    else
        addLog("Fetching next page...", C.SubText)
    end

    task.spawn(function()
        local items, err, more = performSearch(query, CurrentCategory, page)

        Searching = false
        SearchButton.Text = "SEARCH"
        SearchButton.Active = true

        if token ~= SearchToken then return end

        if not items then
            addLog("Roblox API Error: " .. tostring(err), C.Red)
            HasMore = false
            LoadMoreButton.Visible = false
            return
        end

        displayResults(items)

        HasMore = (more == true)
        LoadMoreButton.Visible = HasMore

        if #items > 0 then
            addLog((page == 0 and "FOUND " or "LOADED ") .. #items .. " results.", C.Green)
        else
            addLog("NO RESULTS FOUND", C.Red)
        end

        Results.CanvasPosition = Vector2.new(0, 0)
    end)
end

local function showFavorites()
    Searching = false
    SearchButton.Text = "SEARCH"
    SearchButton.Active = true

    CurrentPage = 0
    HasMore = false
    LoadMoreButton.Visible = false

    clearResults()

    local list = {}
    for _, item in pairs(Favorites) do
        table.insert(list, {
            AssetId = item.id,
            Name = item.name,
            CreatorName = item.creator,
        })
    end

    table.sort(list, function(a, b)
        return tostring(a.Name) < tostring(b.Name)
    end)

    displayResults(list)
    addLog("Favorites: " .. #list, C.Green)
end

--========================== CATEGORY ========================
local function updateCategoryButtons()
    for category, button in pairs(CategoryButtons) do
        local active = (category == CurrentCategory)
        button.BackgroundColor3 = active and C.Accent or C.Input
        button.TextColor3 = active and C.White or C.SubText
    end
end

local function selectCategory(category)
    CurrentCategory = category
    CurrentPage = 0
    HasMore = false
    AudioPages = nil
    Searching = false
    SearchToken += 1

    SearchButton.Text = "SEARCH"
    SearchButton.Active = true
    LoadMoreButton.Visible = false

    updateCategoryButtons()

    if category == "Favorites" then
        showFavorites()
        return
    end

    clearResults()
    addLog("Category: " .. category, C.Cyan)

    local query = trim(SearchBox.Text)
    if query ~= "" then
        search(query, 0)
    end
end

