-- MODEL / DECAL SEARCH
--------------------------------------------------------

local function SearchFreeAssets(
    keyword,
    category
)

    local ok, result

    if category == "Decal"
        or category == "Texture" then

        ok, result = pcall(function()

            return AssetService:GetFreeDecalsAsync(
                keyword,
                CurrentPage,
                CONFIG.SearchLimit
            )

        end)

    else

        ok, result = pcall(function()

            return AssetService:GetFreeModelsAsync(
                keyword,
                CurrentPage,
                CONFIG.SearchLimit
            )

        end)

    end

    if not ok then

        LogMessage(
            "Asset API Error: "
            .. tostring(result),
            C.red
        )

        return nil
    end

    return result
end

--------------------------------------------------------
-- AUDIO SEARCH
--------------------------------------------------------

local function SearchAudio(
    keyword,
    nextPage
)

    local params =
        AudioSearchParams.new()

    params.SearchKeyword =
        keyword

    local ok, page

    if nextPage and AudioPages[1] then

        ok, page = pcall(function()

            AudioPages[1]:
                AdvanceToNextPageAsync()

            return AudioPages[1]

        end)

    else

        ok, page = pcall(function()

            return AssetService:
                SearchAudioAsync(params)

        end)

        if ok then
            AudioPages[1] = page
        end
    end

    if not ok or not page then

        LogMessage(
            "Audio API tidak tersedia: "
            .. tostring(page),
            C.red
        )

        return nil
    end

    local okPage, items =
        pcall(function()
            return page:GetCurrentPage()
        end)

    if not okPage then
        return nil
    end

    return items
end

--------------------------------------------------------
-- ADD RESULTS
--------------------------------------------------------

local function AddResults(items)

    if not items then
        return 0
    end

    local count = 0

    for _, item in ipairs(items) do

        local id =
            getAssetId(item)

        if id then

            local name =
                getAssetName(item)

            local creator =
                getCreatorName(item)

            local meta =
                GetMeta(
                    item,
                    CurrentCategory
                )

            CreateResultCard(
                id,
                name,
                creator,
                meta,
                CurrentCategory
            )

            count += 1
        end
    end

    return count
end

--------------------------------------------------------
-- LOAD FAVORITES
--------------------------------------------------------

function LoadFavorites()

    ClearResults()

    local count = 0

    for _, id in ipairs(FavoriteOrder) do

        local data =
            Favorites[tostring(id)]

        if data then

            CreateResultCard(
                data.id,
                data.name,
                data.creator,
                data.meta,
                data.category
            )

            count += 1
        end
    end

    if count == 0 then

        LogMessage(
            "★ Belum ada Favorites",
            C.yellow
        )

    else

        LogMessage(
            "★ Menampilkan "
            .. tostring(count)
            .. " Favorites",
            C.green
        )

    end
end

--------------------------------------------------------
-- SEARCH
--------------------------------------------------------

local function PerformSearch(
    keyword,
    page
)

    keyword = trim(keyword)

    if keyword == "" then

        LogMessage(
            "Masukkan keyword terlebih dahulu",
            C.yellow
        )

        return
    end

    if Searching then
        return
    end

    Searching = true

    CurrentSearch = keyword

    CurrentPage = page or 0

    SearchButton.Text = "..."

    SearchButton.Active = false

    ClearResults()

    LogMessage(
        "QUERY: " .. keyword,
        C.cyan
    )

    LogMessage(
        "Fetching from Roblox server...",
        C.subtext
    )

    task.spawn(function()

        local items

        if CurrentCategory == "Favorites" then

            Searching = false

            LoadFavorites()

            SearchButton.Text = "SEARCH"
            SearchButton.Active = true

            return
        end

        if CurrentCategory == "Audio" then

            items =
                SearchAudio(
                    keyword,
                    CurrentPage > 0
                )

        else

            items =
                SearchFreeAssets(
                    keyword,
                    CurrentCategory
                )

        end

        if not items then

            Searching = false

            SearchButton.Text = "SEARCH"
            SearchButton.Active = true

            return
        end

        local count =
            AddResults(items)

        if count > 0 then

            LogMessage(
                "FOUND "
                .. tostring(count)
                .. " results",
                C.green
            )

        else

            LogMessage(
                "NO RESULTS FOUND",
                C.red
            )

            LogMessage(
                "Coba keyword lain",
                C.dim
            )
        end

        if CurrentCategory == "Audio" then

            HasMore =
                AudioPages[1]
                and not AudioPages[1].IsFinished
                or false

        else

            HasMore =
                count >= CONFIG.SearchLimit
        end

        LoadMore.Visible = HasMore

        if HasMore then

            LoadMore.Text =
                "⬇ LOAD MORE"

        end

        Searching = false

        SearchButton.Text = "SEARCH"
        SearchButton.Active = true

    end)
end

