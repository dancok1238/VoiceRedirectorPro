-- PROXY INSERT
--------------------------------------------------------

local function CreateProxy(
    assetId,
    category
)

    local part = Instance.new("Part")

    part.Name =
        "SL_Proxy_"
        .. tostring(category)
        .. "_"
        .. tostring(assetId)

    part.Anchored = true
    part.CanCollide = false

    if category == "Audio" then

        part.Size = CONFIG.AudioProxySize
        part.Color = Color3.fromRGB(
            88,
            101,
            242
        )

        part.Material = Enum.Material.Neon

        local sound = Instance.new("Sound")

        sound.Name = "AudioData"
        sound.SoundId =
            "rbxassetid://"
            .. tostring(assetId)

        sound.Volume = 0.5
        sound.Looped = true
        sound.Parent = part

        pcall(function()
            sound:Play()
        end)

    else

        part.Size = CONFIG.ProxySize
        part.Color = Color3.fromRGB(
            220,
            220,
            220
        )

        part.Material =
            Enum.Material.SmoothPlastic

    end

    part.CFrame = GetInsertCFrame()
    part.Parent = workspace

    return part
end

--------------------------------------------------------
-- STUDIO LITE REMOTE INSERT
--------------------------------------------------------

local function TryStudioLiteInsert(assetId)

    local replicated = game:GetService(
        "ReplicatedStorage"
    )

    local folder =
        replicated:FindFirstChild(
            "StudioLiteFolder"
        )

    if not folder then
        return nil
    end

    local remote =
        folder:FindFirstChild(
            "LoadAssetModelToPlayerGuiServerFunction"
        )

    if not remote then
        return nil
    end

    if not remote:IsA("RemoteFunction") then
        return nil
    end

    local ok, result = pcall(function()

        return remote:InvokeServer(
            tonumber(assetId)
        )

    end)

    if ok then
        return result
    end

    return nil
end

--------------------------------------------------------
-- INSERT ASSET
--------------------------------------------------------

local function InsertAsset(
    assetId,
    category,
    name
)

    assetId = tonumber(assetId)

    if not assetId then

        LogMessage(
            "Asset ID tidak valid",
            C.red
        )

        return false
    end

    LogMessage(
        "Memasukkan " .. tostring(name),
        C.text
    )

    ----------------------------------------------------
    -- AUDIO / DECAL / TEXTURE
    ----------------------------------------------------

    if category == "Audio"
        or category == "Decal"
        or category == "Texture" then

        local proxy =
            CreateProxy(
                assetId,
                category
            )

        if proxy then

            LogMessage(
                "✓ " .. category .. " dibuat",
                C.green
            )

            return true
        end

        LogMessage(
            "✕ Gagal membuat proxy",
            C.red
        )

        return false
    end

    ----------------------------------------------------
    -- STUDIO LITE REMOTE
    ----------------------------------------------------

    local result =
        TryStudioLiteInsert(
            assetId
        )

    if result then

        LogMessage(
            "✓ Model berhasil dikirim ke Studio Lite",
            C.green
        )

        return true
    end

    ----------------------------------------------------
    -- FALLBACK
    ----------------------------------------------------

    local proxy =
        CreateProxy(
            assetId,
            category
        )

    if proxy then

        LogMessage(
            "✓ Proxy block dibuat",
            C.green
        )

        return true
    end

    LogMessage(
        "✕ Gagal insert asset",
        C.red
    )

    return false
end

