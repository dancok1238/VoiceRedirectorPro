            showFavorites()
        else
            search(SearchBox.Text, 0)
        end
    end)

    SearchBox.FocusLost:Connect(function(enterPressed)
        if enterPressed and CurrentCategory ~= "Favorites" then
            search(SearchBox.Text, 0)
        end
    end)

    LoadMoreButton.MouseButton1Click:Connect(function()
        if Searching or not HasMore then return end
        CurrentPage += 1
        search(SearchBox.Text, CurrentPage)
    end)

    -- drag
    local dragging = false
    local dragStart, startPosition

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = Main.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStart

            Main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    -- responsive
    local Camera = workspace.CurrentCamera

    local function updateSize()
        if not Camera then return end

        local vp = Camera.ViewportSize
        local width = math.clamp(vp.X * 0.9, CONFIG.MIN_WIDTH, CONFIG.WIDTH)
        local height = math.clamp(vp.Y * 0.85, 300, 420)

        Main.Size = UDim2.fromOffset(width, height)
    end

    if Camera then
        Camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateSize)
    end

    updateSize()

