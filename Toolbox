            return
        end

        if trim(keyBox.Text) ~= CONFIG.OWNER_KEY then
            msg.Text = "Key salah / belum diizinkan."
            msg.TextColor3 = C.Red
            return
        end

        msg.Text = "Key owner benar! Memuat..."
        msg.TextColor3 = C.Green

        local ok, err = pcall(startToolbox, true)

        if ok then
            keyGui:Destroy()
        else
            msg.Text = "ERROR: " .. tostring(err)
            msg.TextColor3 = C.Red
        end
    end

    verify.MouseButton1Click:Connect(check)

    keyBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            check()
        end
    end)
end

startWithAccess = function()
    local name = LocalPlayer.Name

    -- owner (daftar OWNERS) langsung masuk dengan panel admin
    if isOwnerName(name) then
        local ok, err = pcall(startToolbox, true)
        if not ok then
            warn("[BALEREOT] ERROR: " .. tostring(err))
        end
        return
    end

    -- username yang diizinkan langsung masuk tanpa panel admin
    if isAllowedName(name) then
        local ok, err = pcall(startToolbox, false)
        if not ok then
            warn("[BALEREOT] ERROR: " .. tostring(err))
        end
        return
    end

    showKeyScreen()
end

local okAccess, errAccess = pcall(startWithAccess)
if not okAccess then
    warn("[BALEREOT] ACCESS ERROR: " .. tostring(errAccess))
end
