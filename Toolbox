local function IsFavorite(id)
    return Favorites[tostring(id)] ~= nil
end

local function ToggleFavorite(
    id,
    name,
    creator,
    meta,
    category
)

    local key = tostring(id)

    if Favorites[key] then

        Favorites[key] = nil

        for i = #FavoriteOrder, 1, -1 do
            if tostring(FavoriteOrder[i]) == key then
                table.remove(FavoriteOrder, i)
            end
        end

        LogMessage(
            "★ dihapus dari Favorites: " .. tostring(name),
            C.yellow
        )

        SaveFavorites()

        return false
    end

    Favorites[key] = {
        id = id,
        name = name,
        creator = creator,
        meta = meta,
        category = category,
    }

    table.insert(FavoriteOrder, id)

    LogMessage(
        "★ ditambahkan ke Favorites: " .. tostring(name),
        C.yellow
    )

    SaveFavorites()

    return true
end

