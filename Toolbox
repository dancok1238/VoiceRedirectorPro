--------------------------------------------------------
-- SAFE HELPERS
--------------------------------------------------------

local function safeCall(fn, ...)
    local args = table.pack(...)
    local ok, result = pcall(function()
        return fn(table.unpack(args, 1, args.n))
    end)

    if ok then
        return true, result
    end

    return false, result
end

local function trim(text)
    return tostring(text or ""):match("^%s*(.-)%s*$")
end

local function getAssetId(item)
    if not item then
        return nil
    end

    return tonumber(
        item.AssetId
        or item.Id
        or item.AssetID
        or item.id
    )
end

local function getAssetName(item)
    if not item then
        return "Unknown"
    end

    return tostring(
        item.Name
        or item.Title
        or "Unknown"
    )
end

local function getCreatorName(item)
    if not item then
        return "Roblox"
    end

    if item.Creator then
        if typeof(item.Creator) == "table" then
            return tostring(item.Creator.Name or "Roblox")
        end

        local ok, name = pcall(function()
            return item.Creator.Name
        end)

        if ok and name then
            return tostring(name)
        end
    end

    return tostring(
        item.CreatorName
        or "Roblox"
    )
end

