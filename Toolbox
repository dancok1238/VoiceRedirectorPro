        msg.TextColor3 = C.SubText

        local ok = pcall(Players.GetUserIdFromNameAsync, Players, name)

        if ok then
            AllowedSet[name:lower()] = name
            local saved = saveAllowed()
            userBox.Text = ""
            if saved then
                msg.Text = name .. " diizinkan & tersimpan."
            else
