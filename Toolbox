--========================== UTIL ============================
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do
        o[k] = v
    end
    if parent then
        o.Parent = parent
    end
    return o
end

local function corner(o, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r) }, o)
end

local function stroke(o, color, thickness, transparency)
    return new("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
    }, o)
end

local function trim(str)
    return tostring(str or ""):match("^%s*(.-)%s*$")
end

local function getAssetId(item)
    if not item then return nil end
    return tonumber(item.AssetId or item.Id or item.AssetID or item.id)
end

local function getAssetName(item)
    if not item then return "Unknown Asset" end
    return tostring(item.Name or item.Title or "Unknown Asset")
end

local function getCreator(item)
    if not item then return "Roblox" end
    if type(item.Creator) == "table" then
        return tostring(item.Creator.Name or item.Creator.CreatorName or "Roblox")
    end
    return tostring(item.CreatorName or item.Artist or item.Creator or "Roblox")
end

local function addLog(message, color)
    if not LogList then return end

    new("TextLabel", {
        Size = UDim2.new(1, -4, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text = "\u{203A} " .. tostring(message),
        TextColor3 = color or C.Text,
        TextSize = 8,
        Font = Enum.Font.Code,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = #LogList:GetChildren(),
    }, LogList)

    task.defer(function()
        pcall(function()
            LogFrame.CanvasPosition = Vector2.new(0, LogFrame.AbsoluteCanvasSize.Y)
        end)
    end)
end

local function clearResults()
