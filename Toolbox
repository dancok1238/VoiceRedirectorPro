--========================== PLACEMENT =======================
local function getPlacementCFrame()
    local camera = workspace.CurrentCamera
    if not camera then
        return CFrame.new(0, 5, 0)
    end

    local center = camera.ViewportSize / 2
    local ray = camera:ViewportPointToRay(center.X, center.Y)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    if LocalPlayer.Character then
        params.FilterDescendantsInstances = { LocalPlayer.Character }
    end

    local result = workspace:Raycast(ray.Origin, ray.Direction * 150, params)

    if result then
        return CFrame.new(result.Position + Vector3.new(0, 2, 0))
    end

    return CFrame.new(ray.Origin + ray.Direction * 15)
end

local function getAssetFolder()
    local folder = workspace:FindFirstChild(CONFIG.FOLDER_NAME)
    if not folder then
        folder = new("Folder", { Name = CONFIG.FOLDER_NAME }, workspace)
    end
    return folder
end

--========================== INSERT MODEL ====================
local function getStudioLiteRemote()
    local folder = ReplicatedStorage:FindFirstChild(CONFIG.MODEL_REMOTE_FOLDER)
    if folder then
        local remote = folder:FindFirstChild(CONFIG.MODEL_REMOTE_NAME)
        if remote and remote:IsA("RemoteFunction") then
            return remote
        end
    end

    local found = ReplicatedStorage:FindFirstChild(CONFIG.MODEL_REMOTE_NAME, true)
    if found and found:IsA("RemoteFunction") then
        return found
    end

    return nil
end

local function getAllParts(inst)
    local parts = {}
    if inst:IsA("BasePart") then
        table.insert(parts, inst)
    end
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("BasePart") then
            table.insert(parts, d)
        end
    end
    return parts
end

local function placeInstance(inst)
    local cf = getPlacementCFrame()
    local target = inst

    if not inst:IsA("Model") and not inst:IsA("BasePart") then
        local wrapper = Instance.new("Model")
        wrapper.Name = inst.Name
        inst.Parent = wrapper
        wrapper.Parent = getAssetFolder()
        target = wrapper
    else
        inst.Parent = getAssetFolder()
    end

    local parts = getAllParts(target)
    for _, p in ipairs(parts) do
        p.Anchored = true
    end

    if target:IsA("Model") then
        target:PivotTo(cf)
    elseif target:IsA("BasePart") then
        target.CFrame = cf
    end

    return #parts
end

local function insertModel(id)
    local remote = getStudioLiteRemote()

    local before = {}
    for _, c in ipairs(PlayerGui:GetChildren()) do
        before[c] = true
    end

    local model

    if remote then
        addLog("Connecting to Studio Lite server...", C.SubText)

        local success, result = pcall(function()
            return remote:InvokeServer(id)
        end)

        if success then
            if typeof(result) == "Instance" then
                model = result
            else
                task.wait(0.5)
                for _, c in ipairs(PlayerGui:GetChildren()) do
                    if not before[c] and c ~= GUI then
                        model = c
                        break
                    end
                end
            end
        else
            addLog("Remote error: " .. tostring(result), C.Red)
        end
    end

    if not model then
        addLog("Mencoba LoadAsset langsung...", C.SubText)

        local ok, loaded = pcall(function()
            return InsertService:LoadAsset(id)
        end)

        if ok and loaded then
            local children = loaded:GetChildren()
            if #children == 1 then
                model = children[1]
            else
                model = loaded
            end
        else
            addLog("LoadAsset gagal: " .. tostring(loaded), C.Red)
        end
    end

    if not model then
        addLog("Model tidak ditemukan setelah insert.", C.Red)
        return false
    end

    local ok, count = pcall(placeInstance, model)

    if not ok then
        addLog("Place error: " .. tostring(count), C.Red)
        return false
    end

    addLog("Inserted " .. tostring(count) .. " part(s) ke " .. CONFIG.FOLDER_NAME, C.Green)
    return true
end

--========================== IMAGE / MESH ====================
-- ID hasil pencarian Decal/Texture adalah ID asset Decal,
-- jadi ID gambar aslinya diambil dulu dari dalam asset.
local function resolveImageId(id)
    local ok, loaded = pcall(function()
        return InsertService:LoadAsset(id)
    end)

    if ok and loaded then
        local d = loaded:FindFirstChildWhichIsA("Decal", true)
            or loaded:FindFirstChildWhichIsA("Texture", true)

        local img = d and d.Texture or ""
        loaded:Destroy()

        if img ~= "" then
            return img
        end
    end

    return "rbxassetid://" .. tostring(id)
end

local function insertMeshById(meshId, textureId)
    meshId = tonumber(meshId)
    textureId = tonumber(textureId)

    if not meshId then
        addLog("MeshId tidak valid.", C.Red)
        return false
    end

    local texture = textureId and resolveImageId(textureId) or ""
    local cf = getPlacementCFrame()

    -- cara 1: MeshPart asli
    local ok, mesh = pcall(function()
        return AssetService:CreateMeshPartAsync("rbxassetid://" .. tostring(meshId))
    end)

    if ok and mesh then
        mesh.Name = "Balereot_Mesh_" .. tostring(meshId)
        mesh.Anchored = true
        if texture ~= "" then
            mesh.TextureID = texture
        end
        mesh.CFrame = cf
        mesh.Parent = getAssetFolder()

        addLog("MeshPart " .. tostring(meshId) .. " masuk ke " .. CONFIG.FOLDER_NAME, C.Green)
        return true
    end

    addLog("MeshPart gagal, pakai SpecialMesh...", C.Yellow)

    -- cara 2 (cadangan): Part + SpecialMesh, jalan di client
    local part = new("Part", {
        Name = "Balereot_Mesh_" .. tostring(meshId),
        Anchored = true,
        CanCollide = false,
        Size = Vector3.new(4, 4, 4),
        CFrame = cf,
    })

    new("SpecialMesh", {
        MeshType = Enum.MeshType.FileMesh,
        MeshId = "rbxassetid://" .. tostring(meshId),
        TextureId = texture,
        Scale = Vector3.new(1, 1, 1),
    }, part)

    part.Parent = getAssetFolder()

    addLog("Mesh " .. tostring(meshId) .. " masuk (SpecialMesh) ke " .. CONFIG.FOLDER_NAME, C.Green)
    return true
end

--========================== PROXY (Audio/Decal/Texture) =====
local function createProxy(id, category)
    local part = new("Part", {
        Name = "Balereot_" .. tostring(category) .. "_" .. tostring(id),
        Anchored = true,
        CanCollide = false,
        CFrame = getPlacementCFrame(),
    })

    if category == "Audio" then
        part.Size = Vector3.new(2, 2, 2)
        part.Shape = Enum.PartType.Ball
        part.Material = Enum.Material.Neon
        part.Color = C.Purple

        new("Sound", {
            Name = "AssetAudio",
            SoundId = "rbxassetid://" .. tostring(id),
            Volume = 0.5,
            Looped = false,
        }, part)

    elseif category == "Decal" or category == "Texture" then
        part.Size = Vector3.new(4, 4, 0.2)
        part.Material = Enum.Material.SmoothPlastic
        part.Color = C.White

        local img = resolveImageId(id)

        local tex = Instance.new(category == "Decal" and "Decal" or "Texture")
        tex.Name = category .. "Asset"
        tex.Texture = img
        tex.Face = Enum.NormalId.Front
        tex.Parent = part

        addLog("Image ID: " .. tostring(img), C.Cyan)
    end

    part.Parent = getAssetFolder()
    addLog(category .. " " .. tostring(id) .. " inserted ke " .. CONFIG.FOLDER_NAME, C.Green)
    return true
end

local function insertAsset(id, category)
    if category == "Model" then
        return insertModel(id)
    end
    return createProxy(id, category)
end

--========================== SEARCH APIs =====================
local function searchFree(method, query, page, label)
    local success, result = pcall(function()
        return InsertService[method](InsertService, query, page)
    end)

    if not success then
        return nil, tostring(result)
    end

    if type(result) ~= "table" then
        return nil, "Invalid Roblox " .. label .. " response."
    end

    local pageData = result[1]
    if not pageData then
        return {}, nil, false
    end

    local results = pageData.Results or {}
    return results, nil, #results >= CONFIG.MAX_RESULTS
end

local function searchAudio(query, firstPage)
    local success, result = pcall(function()
        if firstPage or not AudioPages then
            local params = Instance.new("AudioSearchParams")
            params.SearchKeyword = query
            return AssetService:SearchAudioAsync(params)
        end

        AudioPages:AdvanceToNextPageAsync()
        return AudioPages
    end)

    if not success then
        AudioPages = nil
        return nil, tostring(result)
    end

    AudioPages = result

    local ok, pageResult = pcall(function()
        return AudioPages:GetCurrentPage()
    end)

    if not ok then
        return nil, tostring(pageResult)
    end

    return pageResult, nil, not AudioPages.IsFinished
end

local function performSearch(query, category, page)
    query = trim(query)
    if query == "" then
        return {}, nil, false
    end

    if category == "Model" then
        return searchFree("GetFreeModelsAsync", query, page, "model")
    elseif category == "Decal" or category == "Texture" then
        return searchFree("GetFreeDecalsAsync", query, page, "decal")
    elseif category == "Audio" then
        return searchAudio(query, page == 0)
    end

    return {}, nil, false
end

