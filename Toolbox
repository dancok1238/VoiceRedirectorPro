local function isOwnerName(name)
    for _, o in ipairs(CONFIG.OWNERS) do
        if tostring(o):lower() == tostring(name):lower() then
            return true
        end
    end
    return false
end

local function isAllowedName(name)
    return AllowedSet[tostring(name):lower()] ~= nil
end

local function getSortedNames()
    local names = {}
    for _, name in pairs(AllowedSet) do
        table.insert(names, name)
    end
    table.sort(names, function(a, b) return a:lower() < b:lower() end)
    return names
end

--========================== SIMPAN PERMANEN =================
local SAVE_FILE = "Balereot_Allowed.json"

local function saveAllowed()
    if not writefile then return false end

    local ok = pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(getSortedNames()))
    end)

    return ok
end

local function loadAllowed()
    if not (isfile and readfile) then return end
    if not isfile(SAVE_FILE) then return end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(SAVE_FILE))
    end)

    if ok and type(data) == "table" then
        for _, n in ipairs(data) do
            AllowedSet[tostring(n):lower()] = tostring(n)
        end
    end
end

