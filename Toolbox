            resultsHeight,
            180
        )

    Results.Size =
        UDim2.new(
            1,
            -16,
            0,
            resultsHeight
        )

    Output.Position =
        UDim2.new(
            0,
            8,
            1,
            -158
        )

end

if Camera then

    Camera:GetPropertyChangedSignal(
        "ViewportSize"
    ):Connect(UpdateSize)

end

